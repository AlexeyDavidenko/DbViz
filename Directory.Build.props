<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Authors>AlexeyDavidenko</Authors>
    <Product>DbViz</Product>
    <Copyright>Copyright 2026 AlexeyDavidenko</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Description>Generates an Obsidian knowledge base (notes, links, layered graph) from the Oracle data dictionary.</Description>
  </PropertyGroup>
</Project>
